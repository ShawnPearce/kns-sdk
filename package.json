{
  "name": "kaspa-names",
  "version": "0.1.0",
  "description": "Resolve .kaspa names — read-only SDK for the KNS covenant-backed name service on Kaspa L1 (forward/reverse resolution, profiles, canonical normalization, on-chain proof verification).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=18" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./normalize": { "types": "./dist/normalize.d.ts", "default": "./dist/normalize.js" },
    "./verify": { "types": "./dist/verify.d.ts", "default": "./dist/verify.js" }
  },
  "files": ["dist", "src", "vectors", "docs", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@noble/hashes": "^1.4.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "keywords": ["kaspa", "kns", "name-service", "resolver", ".kaspa", "wallet"],
  "repository": { "type": "git", "url": "git+https://github.com/ShawnPearce/kns-sdk.git" },
  "homepage": "https://github.com/ShawnPearce/kns-sdk#readme",
  "bugs": { "url": "https://github.com/ShawnPearce/kns-sdk/issues" }
}
